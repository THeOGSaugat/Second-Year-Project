# Copy this file to .env and fill in your own values.
# .env is ignored by git, so your real values are never committed.

# Neon PostgreSQL – POOLED connection (used by the running app)
DATABASE_URL_POOLING="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon PostgreSQL – DIRECT connection (used by Prisma migrations)
DATABASE_URL_UNPOOLING="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Secret used by Auth.js to encrypt the session cookie
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=""

# First Admin account – used only by:  npx prisma db seed
ADMIN_NAME="System Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
